          <mxGeometry x="15" y="45" width="210" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d_art_token" value="&lt;&lt;artifact&gt;&gt;&#xa;&lt;b&gt;Web Storage&lt;/b&gt;&#xa;JWT Token &amp; Active Branch ID" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1c7ed6;fontSize=10;" vertex="1" parent="d_browser_env">
          <mxGeometry x="15" y="120" width="210" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d_art_interceptor" value="&lt;&lt;artifact&gt;&gt;&#xa;&lt;b&gt;HTTP Client Interceptors&lt;/b&gt;&#xa;Gắn Bearer Token &amp; Xử lý lỗi 401" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1c7ed6;fontSize=10;" vertex="1" parent="d_browser_env">
          <mxGeometry x="15" y="185" width="210" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d_art_sse" value="&lt;&lt;artifact&gt;&gt;&#xa;&lt;b&gt;SSE EventSource Client&lt;/b&gt;&#xa;Nhận thông báo thời gian thực" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1c7ed6;fontSize=10;" vertex="1" parent="d_browser_env">
          <mxGeometry x="15" y="250" width="210" height="50" as="geometry" />
        </mxCell>


        <!-- 2. CỘT GIỮA: PRODUCTION VPS UBUNTU -->
        <mxCell id="d_box_server" value="&lt;&lt;device&gt;&gt; Máy chủ Triển khai (Production VPS Ubuntu 24.04 LTS | IP: 163.61.72.183)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#343a40;strokeWidth=1.5;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="d_1">
          <mxGeometry x="460" y="60" width="620" height="820" as="geometry" />
        </mxCell>

        <!-- NGINX Layer -->
        <mxCell id="d_env_nginx" value="&lt;&lt;execution environment&gt;&gt; NGINX Web Server &amp; Reverse Proxy (Port 80 HTTP / 443 HTTPS TLS 1.3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f5ff;strokeColor=#74c0fc;fontStyle=1;fontSize=11;align=left;spacingLeft=15;" vertex="1" parent="d_box_server">
          <mxGeometry x="30" y="45" width="560" height="130" as="geometry" />
        </mxCell>
        <mxCell id="d_art_static" value="&lt;&lt;artifact&gt;&gt; Tĩnh Frontend (/opt/ERP-UTT/frontend/browser)&#xa;SPA Fallback index.html | Nén Gzip" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1971c2;fontSize=10;" vertex="1" parent="d_env_nginx">
          <mxGeometry x="20" y="45" width="245" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d_art_conf" value="&lt;&lt;artifact&gt;&gt; Cấu hình Reverse Proxy (/etc/nginx/sites-available)&#xa;Proxy pass /api/v1/** -&gt; 127.0.0.1:8080" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1971c2;fontSize=10;" vertex="1" parent="d_env_nginx">
          <mxGeometry x="290" y="45" width="250" height="60" as="geometry" />
        </mxCell>

        <!-- Docker Network Layer -->
        <mxCell id="d_env_docker" value="&lt;&lt;execution environment&gt;&gt; Docker Compose Runtime (Mạng nội bộ: backend-network)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f3f0ff;strokeColor=#b197fc;fontStyle=1;fontSize=11;align=left;spacingLeft=15;" vertex="1" parent="d_box_server">
          <mxGeometry x="30" y="220" width="560" height="570" as="geometry" />
        </mxCell>

        <!-- Container: Backend Service -->
        <mxCell id="d_cnt_backend" value="&lt;&lt;container&gt;&gt; backend-service Container (Cổng nội bộ 127.0.0.1:8080)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5f3dc4;fontStyle=1;fontSize=10;" vertex="1" parent="d_env_docker">
          <mxGeometry x="25" y="40" width="510" height="130" as="geometry" />
        </mxCell>
        <mxCell id="d_art_jar" value="&lt;&lt;artifact&gt;&gt; &lt;b&gt;backend-service.jar (Spring Boot 4 / Java 21 OpenJDK)&lt;/b&gt;&#xa;• 32 REST Controllers | 39 Business Services | 39 JPA Repositories&#xa;• JJWT 0.12.6, Bucket4j Rate Limiter, SSE Emitter, MinIO Client" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f0fc;strokeColor=#ae3ec9;fontSize=10;align=center;" vertex="1" parent="d_cnt_backend">
          <mxGeometry x="15" y="40" width="480" height="70" as="geometry" />
        </mxCell>

        <!-- 3 Database Containers arranged side-by-side -->
        <!-- Postgres -->
        <mxCell id="d_cnt_pg" value="&lt;&lt;container&gt;&gt; postgresql" style="swimlane;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2b8a3e;fontStyle=1;fontSize=10;" vertex="1" parent="d_env_docker">
          <mxGeometry x="25" y="240" width="240" height="140" as="geometry" />
