        <!-- KẾT NỐI VÀ ĐƯỜNG TRUYỀN RÕ RÀNG -->
        <!-- Client -> NGINX -->
        <mxCell id="d_link_client_nginx" value="HTTPS / TLS 1.3 (Port 443)&#xa;HTTP 80 -&gt; 301 Redirect" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#1c7ed6;strokeWidth=2;fontSize=11;fontStyle=1;align=center;" edge="1" parent="d_1" source="d_box_client" target="d_env_nginx">
          <mxGeometry relative="1" as="geometry">
