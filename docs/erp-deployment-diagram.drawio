          <mxGeometry x="12" y="35" width="215" height="85" as="geometry" />
        </mxCell>

        <!-- Redis -->
        <mxCell id="d_cnt_redis" value="&lt;&lt;container&gt;&gt; redis" style="swimlane;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c92a2a;fontStyle=1;fontSize=10;" vertex="1" parent="d_env_docker">
          <mxGeometry x="295" y="240" width="240" height="140" as="geometry" />
        </mxCell>
        <mxCell id="d_art_redis_db" value="&lt;&lt;cache&gt;&gt; &lt;b&gt;Redis 7 Server&lt;/b&gt;&#xa;• Port 6379&#xa;• Rate Limit &amp; Token Store&#xa;• OTP TTL &amp; SSE Pub/Sub" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff5f5;strokeColor=#c92a2a;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="d_cnt_redis">
          <mxGeometry x="12" y="35" width="215" height="85" as="geometry" />
        </mxCell>

        <!-- MinIO -->
        <mxCell id="d_cnt_minio" value="&lt;&lt;container&gt;&gt; minio-storage (Port 9000 S3 API / Port 9001 Console)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d9480f;fontStyle=1;fontSize=10;" vertex="1" parent="d_env_docker">
          <mxGeometry x="25" y="420" width="510" height="120" as="geometry" />
        </mxCell>
        <mxCell id="d_art_minio_bucket" value="&lt;&lt;storage&gt;&gt; &lt;b&gt;MinIO S3 Object Store (Bucket: erp-products)&lt;/b&gt;&#xa;Lưu trữ toàn bộ ảnh sản phẩm, danh mục, chứng từ | Volume: minio_data" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff4e6;strokeColor=#d9480f;fontSize=10;align=center;" vertex="1" parent="d_cnt_minio">
          <mxGeometry x="15" y="40" width="480" height="60" as="geometry" />
        </mxCell>


        <!-- 3. CỘT PHẢI: DỊCH VỤ NGOẠI VI -->
        <mxCell id="d_box_cloud" value="&lt;&lt;cloud system&gt;&gt; Dịch vụ Ngoại vi" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#495057;strokeWidth=1.5;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="d_1">
