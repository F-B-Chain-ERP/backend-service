        <mxCell id="c_edge_db_pg" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=none;strokeColor=#495057;strokeWidth=1.5;" edge="1" parent="1" source="c_art_postgres" target="c_node_db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Artifact Dưới: Redis Cache & MinIO S3 -->
        <mxCell id="c_art_storage" value="&lt;&lt;storage&gt;&gt;&#xa;&lt;b&gt;Redis &amp; MinIO Storage&lt;/b&gt;&#xa;• Redis 7 In-Memory (Cổng 6379)&#xa;  (Cache, Rate Limit, OTP, SSE)&#xa;• MinIO S3 Storage (Cổng 9000)&#xa;  (Bucket: erp-products)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=14;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fillColor=#ffffff;strokeColor=#495057;strokeWidth=1.2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1035" y="500" width="240" height="120" as="geometry" />
        </mxCell>

        <mxCell id="c_edge_db_storage" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=none;strokeColor=#495057;strokeWidth=1.5;" edge="1" parent="1" source="c_node_db" target="c_art_storage">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>


        <!-- ========================================== -->
        <!-- 4. DỊCH VỤ ĐÁM MÂY (CLOUD SERVICES)       -->
        <!-- ========================================== -->
        <mxCell id="c_node_cloud" value="&lt;&lt;cloud system&gt;&gt;&#xa;&lt;b&gt;Dịch vụ Đám mây Ngoại vi&lt;/b&gt;&#xa;• Google Identity (OAuth2 Sign-In)&#xa;• Gmail SMTP Server (Gửi mail OTP)" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.08;darkOpacity2=0.15;fillColor=#ffffff;strokeColor=#6c757d;strokeWidth=1.2;fontStyle=0;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="540" y="690" width="250" height="80" as="geometry" />
        </mxCell>

        <mxCell id="c_edge_app_cloud" value="HTTPS (443) / SMTP (587)" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=none;strokeColor=#6c757d;strokeWidth=1.2;fontSize=10;fontStyle=1;align=center;" edge="1" parent="1" source="c_art_backend" target="c_node_cloud">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>


        <!-- ========================================== -->
        <!-- ĐƯỜNG TRUYỀN CHÍNH (COMMUNICATION PATHS)   -->
        <!-- ========================================== -->
        <!-- Máy khách -> Ứng dụng -->
        <mxCell id="c_link_client_app" value="Giao thức HTTPS / TLS 1.3&#xa;(Cổng 443 / Cổng 80)" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#000000;strokeWidth=2;fontSize=12;fontStyle=1;align=center;" edge="1" parent="1" source="c_node_client" target="c_node_app">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Ứng dụng -> Database -->
        <mxCell id="c_link_app_db" value="Giao thức TCP (Mạng nội bộ)&#xa;JDBC (5432) | RESP (6379) | S3 (9000)" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#000000;strokeWidth=2;fontSize=12;fontStyle=1;align=center;" edge="1" parent="1" source="c_node_app" target="c_node_db">
          <mxGeometry relative="1" as="geometry" />
