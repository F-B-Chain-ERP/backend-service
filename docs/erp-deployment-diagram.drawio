        <!-- Artifact Trên: PostgreSQL Database -->
        <mxCell id="c_art_postgres" value="&lt;&lt;database&gt;&gt;&#xa;&lt;b&gt;CSDL PostgreSQL 16&lt;/b&gt;&#xa;• Database chính: erp_dev (5432)&#xa;• Quản lý schema: Liquibase&#xa;• Dữ liệu hệ thống, kho, bán hàng" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=14;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fillColor=#ffffff;strokeColor=#495057;strokeWidth=1.2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1035" y="130" width="240" height="110" as="geometry" />
