              <mxPoint x="400" y="170" />
              <mxPoint x="400" y="170" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- NGINX -> Backend -->
        <mxCell id="d_link_nginx_be" value="Proxy Pass: http://127.0.0.1:8080" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;strokeColor=#7048e8;strokeWidth=1.5;dashed=1;fontSize=10;fontStyle=1;align=center;" edge="1" parent="d_box_server" source="d_env_nginx" target="d_cnt_backend">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Backend -> Postgres -->
        <mxCell id="d_link_be_pg" value="JDBC (Port 5432)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;strokeColor=#2b8a3e;strokeWidth=1.5;fontSize=10;fontStyle=1;align=center;" edge="1" parent="d_env_docker" source="d_cnt_backend" target="d_cnt_pg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Backend -> Redis -->
        <mxCell id="d_link_be_redis" value="RESP (Port 6379)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;strokeColor=#c92a2a;strokeWidth=1.5;fontSize=10;fontStyle=1;align=center;" edge="1" parent="d_env_docker" source="d_cnt_backend" target="d_cnt_redis">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Backend -> MinIO -->
        <mxCell id="d_link_be_minio" value="S3 API (Port 9000)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;strokeColor=#d9480f;strokeWidth=1.5;fontSize=10;fontStyle=1;align=center;" edge="1" parent="d_env_docker" source="d_cnt_backend" target="d_cnt_minio">
