  <diagram id="standard-3tier-clean" name="Biểu đồ Triển khai 3 Tầng (Chuẩn UML)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ========================================== -->
        <!-- 1. MÁY KHÁCH (CLIENT NODE)                 -->
        <!-- ========================================== -->
        <mxCell id="c_node_client" value="&lt;&lt;device&gt;&gt;&#xa;&lt;b&gt;Máy khách&lt;/b&gt;&#xa;(Client Device / PC / POS)" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.08;darkOpacity2=0.15;fillColor=#f8f9fa;strokeColor=#343a40;strokeWidth=1.5;fontStyle=0;fontSize=13;align=center;" vertex="1" parent="1">
