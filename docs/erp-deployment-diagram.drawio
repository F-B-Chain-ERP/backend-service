  <diagram id="detailed-clean-deployment" name="Kiến trúc Triển khai Chi tiết (Docker & VPS)">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="d_0" />
        <mxCell id="d_1" parent="d_0" />

        <!-- 1. CỘT TRÁI: MÁY KHÁCH -->
        <mxCell id="d_box_client" value="&lt;&lt;device&gt;&gt; Máy khách (Client Device)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#495057;strokeWidth=1.5;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="d_1">
