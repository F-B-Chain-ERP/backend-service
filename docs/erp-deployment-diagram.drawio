      </root>
    </mxGraphModel>
  </diagram>


  <!-- ========================================================== -->
  <!-- TAB 2: KIẾN TRÚC TRIỂN KHAI CHI TIẾT (NGĂN NẮP, KHÔNG RỐI)-->
