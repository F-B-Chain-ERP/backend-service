{
  "info": {
    "name": "ERP Backend - Auth",
    "description": "Postman collection for all authentication endpoints of the ERP backend-service.\nBase path: /api/v1/auth\nDefault server: http://localhost:8080",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "verify_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "reset_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "account_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register (Customer)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Nguyen Van A\",\n  \"phone\": \"0901234567\",\n  \"email\": \"customer@example.com\",\n  \"password\": \"Password@123\",\n  \"authProvider\": \"LOCAL\"\n}"
            },
            "description": "Public. Self-registration for a customer. Returns AuthResponse with verifyToken for email verification."
          },
          "response": []
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usernameOrEmail\": \"customer@example.com\",\n  \"password\": \"Password@123\",\n  \"type\": \"CUSTOMER\"\n}"
            },
            "description": "Public. Login by username / email / phone. type can be ACCOUNT or CUSTOMER."
          },
          "response": []
        },
        {
          "name": "Verify Email (OTP)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/verify-email",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "verify-email"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"verifyToken\": \"{{verify_token}}\",\n  \"otp\": \"123456\"\n}"
            },
            "description": "Public. Verify email OTP after register/login using the verifyToken from the response."
          },
          "response": []
        },
        {
          "name": "Resend OTP",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/resend-otp",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "resend-otp"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"verifyToken\": \"{{verify_token}}\"\n}"
            },
            "description": "Public. Resend the email verification OTP."
          },
          "response": []
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/forgot-password",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "forgot-password"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@example.com\",\n  \"type\": \"CUSTOMER\"\n}"
            },
            "description": "Public. Request an OTP + reset token via email."
          },
          "response": []
        },
        {
          "name": "Reset Password (OTP)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/reset-password",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "reset-password"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resetToken\": \"{{reset_token}}\",\n  \"otp\": \"123456\",\n  \"newPassword\": \"NewPassword@123\"\n}"
            },
            "description": "Public. Set a new password using reset token + OTP."
          },
          "response": []
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/change-password",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "change-password"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"oldPassword\": \"Password@123\",\n  \"newPassword\": \"NewPassword@123\"\n}"
            },
            "description": "Auth required. Change password for the currently logged-in user."
          },
          "response": []
        },
        {
          "name": "Login with Google (OAuth2)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/oauth2/google",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "oauth2", "google"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idToken\": \"<google-jwt-id-token>\"\n}"
            },
            "description": "Public. Login or register via Google idToken."
          },
          "response": []
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/refresh-token",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "refresh-token"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}"
            },
            "description": "Public. Issue a new access/refresh token pair."
          },
          "response": []
        },
        {
          "name": "Select Branch",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/select-branch",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "select-branch"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"branchId\": \"00000000-0000-0000-0000-000000000000\"\n}"
            },
            "description": "Auth required. Choose the working branch after login."
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "logout"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}"
            },
            "description": "Auth required. Revoke the session using the refresh token."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Accounts (Admin)",
      "item": [
        {
          "name": "Admin Reset Password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/accounts/:id/reset-password",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "accounts", ":id", "reset-password"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"NewPassword@123\"\n}"
            },
            "description": "Auth required (admin). Reset an internal account's password by account id."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Branches",
      "item": [
        {
          "name": "Get Branches by Account",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/branches/account/{{account_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "branches", "account", "{{account_id}}"]
            },
            "description": "Auth required. Get all branches assigned to an account by accountId."
          },
          "response": []
        }
      ]
    }
  ]
}
