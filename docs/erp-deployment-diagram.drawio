        </mxCell>
        <mxCell id="d_cloud_google" value="&lt;&lt;cloud system&gt;&gt;&#xa;&lt;b&gt;Google Identity Platform&lt;/b&gt;&#xa;Xác thực Google OAuth2 Token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#495057;fontSize=11;align=center;" vertex="1" parent="d_box_cloud">
          <mxGeometry x="20" y="60" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="d_cloud_gmail" value="&lt;&lt;cloud system&gt;&gt;&#xa;&lt;b&gt;Gmail SMTP Server&lt;/b&gt;&#xa;smtp.gmail.com:587 (TLS)&#xa;Gửi email OTP &amp; Thông báo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#495057;fontSize=11;align=center;" vertex="1" parent="d_box_cloud">
          <mxGeometry x="20" y="170" width="230" height="75" as="geometry" />
        </mxCell>
        <mxCell id="d_cloud_prom" value="&lt;&lt;subsystem&gt;&gt;&#xa;&lt;b&gt;Prometheus / Grafana&lt;/b&gt;&#xa;Giám sát metrics /actuator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#495057;fontSize=11;align=center;" vertex="1" parent="d_box_cloud">
          <mxGeometry x="20" y="285" width="230" height="70" as="geometry" />
