        <!-- ========================================== -->
        <mxCell id="c_node_db" value="&lt;&lt;device&gt;&gt;&#xa;&lt;b&gt;Database &amp; Storage&lt;/b&gt;&#xa;(Hạ tầng Dữ liệu Server)" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.08;darkOpacity2=0.15;fillColor=#f8f9fa;strokeColor=#343a40;strokeWidth=1.5;fontStyle=0;fontSize=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="1030" y="330" width="250" height="90" as="geometry" />
