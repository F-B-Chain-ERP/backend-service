          <mxGeometry x="80" y="130" width="220" height="110" as="geometry" />
        </mxCell>

        <mxCell id="c_edge_client_art" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=none;strokeColor=#495057;strokeWidth=1.5;" edge="1" parent="1" source="c_art_browser" target="c_node_client">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>


        <!-- ========================================== -->
        <!-- 2. MÁY CHỦ ỨNG DỤNG (APPLICATION SERVER)   -->
        <!-- ========================================== -->
        <mxCell id="c_node_app" value="&lt;&lt;device&gt;&gt;&#xa;&lt;b&gt;Máy chủ Ứng dụng&lt;/b&gt;&#xa;(Server VPS Ubuntu 24.04)" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.08;darkOpacity2=0.15;fillColor=#f8f9fa;strokeColor=#343a40;strokeWidth=1.5;fontStyle=0;fontSize=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="540" y="330" width="250" height="90" as="geometry" />
        </mxCell>

        <!-- Artifact Trên: NGINX Reverse Proxy -->
        <mxCell id="c_art_nginx" value="&lt;&lt;artifact&gt;&gt;&#xa;&lt;b&gt;NGINX Web Server&lt;/b&gt;&#xa;• SSL Let's Encrypt (HTTPS 443)&#xa;• Phục vụ tệp tĩnh Angular (Gzip)&#xa;• Proxy Pass: /api/v1/**" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=14;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fillColor=#ffffff;strokeColor=#495057;strokeWidth=1.2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="545" y="130" width="240" height="110" as="geometry" />
        </mxCell>

        <mxCell id="c_edge_app_nginx" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=none;strokeColor=#495057;strokeWidth=1.5;" edge="1" parent="1" source="c_art_nginx" target="c_node_app">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Artifact Dưới: Ứng dụng quản lý ERP Backend -->
        <mxCell id="c_art_backend" value="&lt;&lt;artifact&gt;&gt;&#xa;&lt;b&gt;Ứng dụng quản lý ERP&lt;/b&gt;&#xa;• backend-service.jar (Spring Boot 4)&#xa;• Java 21 Runtime (Cổng 8080)&#xa;• 32 Controllers &amp; 39 Services&#xa;• Bảo mật JJWT &amp; Rate Limiting" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=14;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fillColor=#ffffff;strokeColor=#495057;strokeWidth=1.2;fontSize=11;" vertex="1" parent="1">
