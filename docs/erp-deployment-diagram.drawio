        <mxCell id="d_browser_env" value="&lt;&lt;execution environment&gt;&gt;&#xa;&lt;b&gt;Trình duyệt Web (Browser)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9ecef;strokeColor=#adb5bd;fontStyle=0;fontSize=11;" vertex="1" parent="d_box_client">
